{
  "name": "outlook-planner",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first Canadian retirement planning app.",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "agent:preflight": "node scripts/agent-preflight.mjs",
    "agent:pr-ready": "node scripts/agent-pr-ready.mjs",
    "agent:e2e": "npm run e2e -w app",
    "build": "npm run build -w app",
    "dev": "npm run dev -w app",
    "e2e": "npm run e2e -w app",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "npm run lint -w app",
    "test": "npm run test -w app",
    "typecheck": "npm run typecheck -w app"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
